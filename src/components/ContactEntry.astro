---
/**
 * 联系入口（S1-T7）。站点页脚、关于页与作品详情页共用同一实现，
 * 数据只来自 `src/lib/site.ts` 的 `contacts`，组件不硬编码地址。
 *
 * 依据：规格第 2 节（页脚提供 GitHub 与邮箱）、第 3 节（联系入口沿用已确认的 GitHub 与邮箱，
 * 不自动新增电话、住址、求职城市、薪资或可入职时间）、第 11.4 节（图标统一 Lucide 规格、
 * 陌生图标具备可访问名称与悬停提示、主要触摸目标 44px、键盘焦点始终可见）、
 * 第 12 节（外链解析规则：HTTPS 检查主机与凭据）、R15（图标规格统一为 Lucide）。
 *
 * 图标与可访问名称：图标采用 Lucide 的 24 网格几何与 2px 线宽（stroke-width 2、圆角端点），
 * 尺寸只取 16/20/24 三档。图标带 `role="img"` 与 `aria-label`，因此本身具备可访问名称；
 * 链接同时显式声明 `aria-label`，使链接名恰好等于可见标签，不出现「GitHub GitHub」式重复播报，
 * 并满足 WCAG 2.5.3（可见标签包含在可访问名称内）。
 *
 * 悬停提示：本组件始终输出可见的简短标签（触屏用户无法靠悬停了解陌生图标），
 * 因此不再叠加 `title` 造成读屏重复播报。
 *
 * 无脚本：纯静态链接，不依赖任何脚本注入内容。
 */

import type { ContactIcon } from '../lib/site'

interface Props {
  /** 可见的简短标签，同时作为链接与图标的可访问名称 */
  label: string
  /** 已核验的联系地址；经 `src/lib/site.ts` 的 `contacts` 传入 */
  href: string
  /** 图标标识；新增联系入口时同步扩展 `src/lib/site.ts` 的 `ContactIcon` */
  icon: ContactIcon
  /** 外链需要 `target` 与 `rel`；站内协议（如 `mailto:`）保持 false */
  external?: boolean
  /** 图标尺寸档位（Lucide 规格）；默认 20 */
  size?: 16 | 20 | 24
  /**
   * 可选第二行：说明链接指向何处（邮箱地址、主机与路径等）。
   * 提供时会并入链接的可访问名称，使可见文字包含在名称内（WCAG 2.5.3）。
   */
  detail?: string | null
}

const { label, href, icon, external = false, size = 20, detail = null } = Astro.props

const accessibleName = detail ? `${label} ${detail}` : label

/**
 * 外链固定新窗口打开并带上 `noopener noreferrer`（规格第 12 节）；
 * `mailto:` 这类站内协议不加 `target`——它没有「新标签页」语义，
 * 交给浏览器与邮件客户端处理。
 */
const linkAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {}
---

<a class="contact-entry touch-target" href={href} aria-label={accessibleName} {...linkAttrs}>
  <svg
    class="contact-entry__icon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    role="img"
    aria-label={label}
    focusable="false"
  >
    {
      icon === 'github' ? (
        <>
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </>
      ) : (
        <>
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </>
      )
    }
  </svg>
  {
    detail ? (
      <span class="contact-entry__text">
        <span class="contact-entry__label">{label}</span>
        <span class="contact-entry__detail">{detail}</span>
      </span>
    ) : (
      <span class="contact-entry__label">{label}</span>
    )
  }
</a>

<style>
  /* 44px 触摸目标由全局 .touch-target 提供，此处只排布图标与标签。
     不额外加水平内边距，避免页脚列表为了对齐而引入负外边距。 */
  .contact-entry {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-ui);
  }

  /* 图标不参与伸缩，尺寸由 size 档位决定 */
  .contact-entry__icon {
    flex: none;
  }

  /* 提供第二行时改为「图标 + 两行文字」的纵向排布，触摸目标仍由 .touch-target 保证 */
  .contact-entry__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
  }

  .contact-entry__detail {
    color: var(--color-text-secondary);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-regular);
  }
</style>
