---
/**
 * 首页身份区与山湖主视觉（S1-T8）。
 *
 * 设计依据：规格第 3 节（H1 为 MoMingYu、方向为关注与求职方向、主要入口「查看作品」与「联系我」、
 * 简历入口缺失时直接省略）、第 11.1 节（全幅图片背景上的开放排版，姓名与入口不套卡片，
 * 局部遮罩只服务文字可读性）、第 11.2 节（首屏不强制 100vh，须露出下一节标题）、
 * 第 9 节（预载与实际渲染复用同一媒体描述）。
 *
 * 主题选图：`<source media>` 只能表达系统外观，读不到 `data-theme`。因此
 * 「跟随系统」时保留 `<source>` 由浏览器原生处理；访客显式选定偏好时由页面脚本
 * 接管选图，并等目标图解码完成再提交，失败则保留已成功显示的图。
 */
import { contacts, hero, identity, seo } from '../../lib/site'
import { imgAttributes } from '../../lib/media'
import { sitePath } from '../../lib/paths'
import { formatMonthDay, formatWeekday, formatYear, greetingFor, isoDate } from '../../lib/datetime'

const base = import.meta.env.BASE_URL
const light = imgAttributes(hero.light, base, { priority: true })
const dark = imgAttributes(hero.dark, base, { priority: true })

/** 构建期日期与问候：无脚本时的回退文本，加载后由脚本按访客本地时间重算 */
const builtAt = new Date()
const dateText = {
  iso: isoDate(builtAt),
  monthDay: formatMonthDay(builtAt),
  year: formatYear(builtAt),
  weekday: formatWeekday(builtAt, seo.locale),
  greeting: greetingFor(builtAt.getHours()),
}

const projectsHref = sitePath(base, 'projects')
/** 联系我直达已核验的邮箱；缺失时不渲染该入口，不留失效按钮 */
const mailContact = contacts.find((contact) => contact.icon === 'mail')
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero__media">
    <picture class="hero__picture" data-hero-picture>
      <img
        class="hero__image"
        data-hero-image
        data-light-src={light.src}
        data-dark-src={dark.src}
        alt={light.alt}
        width={light.width}
        height={light.height}
        loading={light.loading}
        decoding={light.decoding}
        {...(light.fetchpriority ? { fetchpriority: light.fetchpriority } : {})}
      />
    </picture>
    <noscript>
      <picture class="hero__picture">
        <source media="(prefers-color-scheme: dark)" srcset={dark.src} />
        <img
          class="hero__image"
          src={light.src}
          alt={light.alt}
          width={light.width}
          height={light.height}
        />
      </picture>
    </noscript>
  </div>

  <script is:inline>
    /*
     * 首屏选图：src 不写死在 HTML 里。若写死，浏览器会先下载系统主题那一张，
     * 而访客显式选过主题且与系统不一致时，这张是多余的——实测会被完整下载（约 56KB）。
     * data-theme 已由 <head> 的引导脚本在首次绘制前确定，这里只做一次选择。
     * 无脚本时由上面的 <noscript> 按系统外观选图。
     * 注意：本脚本是内联脚本，第四阶段 S4-T10 生成 CSP hash 时必须一并覆盖，
     * 否则首屏主视觉会缺图（页面其余部分与文字仍可读，模块脚本会兜底补上）。
     */
    ;(function () {
      var image = document.querySelector('[data-hero-image]')
      if (!image) return
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark'
      var src = image.getAttribute(isDark ? 'data-dark-src' : 'data-light-src')
      if (src) image.setAttribute('src', src)
    })()
  </script>

  <div class="hero__content container">
    <p class="hero__meta">
      <time class="hero__date" datetime={dateText.iso} data-hero-date>
        <span data-hero-month-day>{dateText.monthDay}</span>
        <span class="hero__date-year" data-hero-year>{dateText.year}</span>
      </time>
      <span class="hero__meta-sep" aria-hidden="true">·</span>
      <span data-hero-weekday>{dateText.weekday}</span>
      <span class="hero__meta-sep" aria-hidden="true">·</span>
      <span data-hero-greeting>{dateText.greeting}</span>
    </p>

    <h1 class="hero__name display-name" id="hero-name">{identity.brand}</h1>
    <p class="hero__direction">{identity.direction}</p>
    <p class="hero__tagline">{identity.tagline}</p>

    <p class="hero__actions">
      <a class="hero__action hero__action--primary touch-target" href={projectsHref}>查看作品</a>
      {
        mailContact ? (
          <a class="hero__action touch-target" href={mailContact.href}>
            联系我
          </a>
        ) : null
      }
    </p>
  </div>
</section>

<script>
  import type { Theme } from '../../lib/theme'
  import { formatMonthDay, formatWeekday, formatYear, greetingFor, isoDate } from '../../lib/datetime'

  /** 日期与问候在加载时求值一次；不用定时器，访客停留期间跨零点不更新是可接受的 */
  const locale = document.documentElement.lang || 'zh-CN'
  const now = new Date()
  const setText = (name: string, text: string): void => {
    const el = document.querySelector<HTMLElement>(`[data-hero-${name}]`)
    if (el) el.textContent = text
  }
  setText('month-day', formatMonthDay(now))
  setText('year', formatYear(now))
  setText('weekday', formatWeekday(now, locale))
  setText('greeting', greetingFor(now.getHours()))
  const timeEl = document.querySelector<HTMLTimeElement>('[data-hero-date]')
  if (timeEl) timeEl.dateTime = isoDate(now)

  const image = document.querySelector<HTMLImageElement>('[data-hero-image]')

  /** 请求序号：只提交最后一次请求的结果，避免快速连续切换时旧结果覆盖新结果 */
  let requestId = 0

  async function commitThemeImage(theme: Theme): Promise<void> {
    if (!image) return
    const target = theme === 'dark' ? image.dataset.darkSrc : image.dataset.lightSrc
    if (!target || image.getAttribute('src') === target) return

    const current = ++requestId
    const probe = new Image()
    probe.src = target
    try {
      await probe.decode()
    } catch {
      // 目标图失败：保留已成功显示的图，不让正常切换表现为资源故障
      return
    }
    if (current !== requestId) return
    image.setAttribute('src', target)
  }

  function currentTheme(): Theme {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'
  }

  // 兜底：内联脚本被 CSP 拦下时由这里补上首屏选图（此时可能多下载一张，但不会缺图）
  void commitThemeImage(currentTheme())

  // 主题控件改变 data-theme 后换图：等目标图解码完成再提交
  new MutationObserver(() => void commitThemeImage(currentTheme())).observe(
    document.documentElement,
    { attributes: true, attributeFilter: ['data-theme'] },
  )
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    /*
     * 不强制 100vh：高度由视口、内容与下一节的可见空间共同决定（规格 11.2）。
     * 上限 600px 是为了在 320×680 这类短屏上仍能露出下一节的标题——
     * 实测 320×680 下主视觉底部 + 首个分区的编号与标题需要约 90px 才够。
     */
    min-block-size: min(70svh, 600px);
    overflow: hidden;
    background-color: var(--color-surface-page);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__picture,
  .hero__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__image {
    object-fit: cover;
    object-position: 50% 50%;
  }

  /*
   * 文字组局部遮罩：只服务文字可读性，不把整张图统一压暗（规格 11.1）。
   * 遮罩覆盖下部文字所在的条带，上半部风景保持原样。
   */
  .hero::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 62%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      var(--color-overlay-scrim) 0%,
      color-mix(in srgb, var(--color-overlay-scrim) 72%, transparent) 55%,
      transparent 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-block: var(--space-2xl) var(--space-3xl);
    /* 照片之上的文字用不随主题变化的浅色；--color-accent-contrast 是"操作色之上的文字"，
       深色主题下它是深色，直接拿来当主视觉文字色会让姓名几乎看不见 */
    color: var(--color-text-on-media);
  }

  /* 日期与问候：次要元素，一行紧凑呈现，不与姓名、入口并列成大面板（规格第 3 节） */
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
    margin-block-end: var(--space-md);
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-normal);
    opacity: 0.92;
  }

  .hero__date {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .hero__date-year {
    font-size: var(--font-size-caption, var(--font-size-label));
    opacity: 0.8;
  }

  .hero__meta-sep {
    opacity: 0.6;
  }

  .hero__name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--font-size-name);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-normal);
  }

  .hero__direction {
    margin-block-start: var(--space-sm);
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-medium);
  }

  .hero__tagline {
    max-width: 30em;
    margin-block-start: var(--space-xs);
    font-size: var(--font-size-body);
    opacity: 0.92;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
  }

  .hero__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-lg);
    border: var(--border-width) solid currentColor;
    border-radius: var(--radius-pill);
    /* 次级入口压在照片上：垫一层半透明深色底，白字白边才在明亮区域也读得清 */
    background-color: var(--color-action-on-media-backdrop);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--easing-standard);
  }

  .hero__action--primary {
    border-color: transparent;
    background-color: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  /* 窄屏按 640px 图片断点切换裁切焦点，让湖面主体保持在视野内 */
  @media (max-width: 640px) {
    .hero__image {
      object-position: 60% 50%;
    }

    .hero__content {
      padding-block: var(--space-xl) var(--space-2xl);
    }

    .hero__meta {
      margin-block-end: var(--space-sm);
    }

    .hero__actions {
      margin-block-start: var(--space-lg);
    }
  }
</style>
