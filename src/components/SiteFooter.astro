---
/**
 * 站点页脚（S1-T7）。由 `src/layouts/BaseLayout.astro` 渲染在所有公开页面末尾。
 *
 * 依据：规格第 2 节（页脚提供 GitHub、邮箱与具备公开文章时的订阅入口）、
 * 第 3 节（联系入口沿用已确认的 GitHub 与邮箱）、第 11.4 节（不向访客展示设计说明、
 * 组件说明、操作教程或「此处用于展示」等编辑文案；键盘焦点始终可见；触摸目标 44px）、
 * 第 12 节（外链规则与索引表达）。
 *
 * 版权年份：在构建期由 `new Date()` 求值一次并写入静态 HTML，浏览器端不计算年份，
 * 无脚本时年份照常可读（规格第 2 节 / S1-T7）。
 *
 * 内容边界：本组件不渲染任何编辑说明（例如「内容与图片为示意」）。占位素材与演示内容的
 * 阻断由第四阶段 S4-T3 的发布就绪检查承担，不靠页脚声明代替（跨计划裁决 R12）。
 *
 * 页脚不重复堆叠联系入口：只在这里提供一次 GitHub 与一次邮箱；关于页与作品详情页的
 * 各一次联系入口分别由 S1-T10 与第二阶段负责，不在本组件内重复。
 */

import ContactEntry from './ContactEntry.astro'
import { contacts, identity } from '../lib/site'

interface Props {
  /**
   * 订阅入口接入位（第三阶段 S3-T9）：仅在存在公开文章时由调用方传入。
   * 省略或传 null 时整块不渲染——当前没有公开文章，因此不输出订阅链接，
   * 也不保留失效入口或占位按钮（规格第 2 节、A05）。
   * `href` 需已是 base 感知的地址（`/rss.xml` 是文件而非页面，用 `assetPath` 生成，不要用 `sitePath`）。
   */
  subscribe?: { label: string; href: string } | null
}

const { subscribe = null } = Astro.props

/** 版权年份：Astro 组件在构建期执行，因此这里是构建时钟，不是客户端时钟 */
const buildYear = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__copy">© {buildYear} {identity.brand}</p>
    <nav class="site-footer__contact" aria-label="联系方式">
      <ul class="list-plain site-footer__list">
        {
          contacts.map((contact) => (
            <li>
              <ContactEntry
                label={contact.label}
                href={contact.href}
                icon={contact.icon}
                external={contact.external}
              />
            </li>
          ))
        }
        {
          subscribe ? (
            <li>
              <a
                class="site-footer__subscribe touch-target"
                href={subscribe.href}
                aria-label={subscribe.label}
              >
                <svg
                  class="site-footer__subscribe-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  role="img"
                  aria-label={subscribe.label}
                  focusable="false"
                >
                  <path d="M4 11a9 9 0 0 1 9 9" />
                  <path d="M4 4a16 16 0 0 1 16 16" />
                  <circle cx="5" cy="19" r="1" />
                </svg>
                <span class="site-footer__subscribe-label">{subscribe.label}</span>
              </a>
            </li>
          ) : null
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-2xl);
    padding-block: var(--space-xl);
    border-top: var(--divider);
    color: var(--color-text-secondary);
    font-size: var(--font-size-label);
    line-height: var(--line-height-ui);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
  }

  .site-footer__copy {
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
  }

  /* 联系入口横排在桌面、窄屏自动换行；不设固定宽度，长地址自然换行 */
  .site-footer__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-lg);
  }

  /* 订阅入口与 ContactEntry 保持同一视觉规格（S3-T9 接入后生效） */
  .site-footer__subscribe {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-ui);
  }

  .site-footer__subscribe-icon {
    flex: none;
  }
</style>
