---
/**
 * 首页（S1-T8 身份区 + S1-T9 章节骨架）。
 *
 * 章节顺序固定为「身份与定位、精选软件作品、硬件实践、最近文章、简短关于与联系」（规格第 3 节）。
 * 本阶段只交付**真实入口与诚实空状态**：不预留虚构卡片、假封面、假日期或假项目。
 * 接入点由 `data-home-projects`、`data-home-hardware`、`data-home-posts` 标记：
 * 精选软件作品由第二阶段 S2-T6 接入真实条目，硬件实践与最近文章由第三阶段 S3-T9 接入。
 * 两处都只需替换数据来源，不调整已确认的视觉与结构。
 * 接入点刻意写成 data 属性而不是 HTML 注释——注释会随产物发布给访客，属内部过程信息外泄。
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/home/Hero.astro'
import SectionHeader from '../components/SectionHeader.astro'
import ContactEntry from '../components/ContactEntry.astro'
import { contacts, identity } from '../lib/site'
import { sitePath } from '../lib/paths'

const base = import.meta.env.BASE_URL
const hardwareHref = sitePath(base, 'hardware')
const blogHref = sitePath(base, 'blog')
const aboutHref = sitePath(base, 'about')

const pageDescription = `${identity.brand} 的个人主页：${identity.direction}。作品、电脑 DIY 与超频实践，以及技术文章。`
---

<BaseLayout description={pageDescription}>
  <Hero />

  <div class="container container--home">
    <section class="section section--first home-first" aria-labelledby="home-projects" data-home-projects>
      <SectionHeader number="01" title="精选软件作品" id="home-projects" />
      <p class="home-empty">暂无公开作品。</p>
    </section>

    <section class="section" aria-labelledby="home-hardware" data-home-hardware>
      <SectionHeader number="02" title="硬件实践" id="home-hardware" />
      <p class="home-empty">暂无公开的装机与超频记录。</p>
      <p class="home-entry">
        <a class="home-entry__link" href={hardwareHref}>查看硬件实践</a>
      </p>
    </section>

    <section class="section" aria-labelledby="home-posts" data-home-posts>
      <SectionHeader number="03" title="最近文章" id="home-posts" />
      <p class="home-empty">暂无公开文章。</p>
      <p class="home-entry">
        <a class="home-entry__link" href={blogHref}>浏览全部文章</a>
      </p>
    </section>

    <section class="section" aria-labelledby="home-about" data-home-about>
      <SectionHeader number="04" title="关于与联系" id="home-about" />
      <p class="home-about">{identity.tagline}</p>
      <ul class="home-contact list-plain">
        {
          contacts.map((contact) => (
            <li>
              <ContactEntry
                label={contact.label}
                href={contact.href}
                icon={contact.icon}
                external={contact.external}
              />
            </li>
          ))
        }
      </ul>
      <p class="home-entry">
        <a class="home-entry__link" href={aboutHref}>了解更多</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /* 紧跟全幅主视觉的首个分区：不画分隔线，上留白收紧，让下一节标题尽早进入首屏 */
  .home-first {
    padding-block-start: var(--space-xl);
  }

  /* 分区组织：细分隔线与留白，不把整节包进卡片（规格 11.2） */
  .home-empty {
    max-width: 36em;
    margin-block-start: var(--space-md);
    color: var(--color-text-secondary);
  }

  .home-about {
    max-width: 36em;
    margin-block-start: var(--space-md);
  }

  .home-entry {
    margin-block-start: var(--space-md);
  }

  .home-entry__link {
    font-weight: var(--font-weight-medium);
  }

  .home-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
    margin-block-start: var(--space-lg);
  }
</style>
