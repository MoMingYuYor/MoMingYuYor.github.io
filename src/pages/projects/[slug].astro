---
/**
 * 项目详情（S2-T5）。
 *
 * `getStaticPaths` 只从 `getPublicProjects()` 生成参数：草稿与未到发布日期的条目
 * 不会生成任何 HTML，而不是"隐藏入口但页面仍存在"。
 */
import { render } from 'astro:content'

import ProjectLayout from '../../layouts/ProjectLayout.astro'
import ProjectFacts from '../../components/project/ProjectFacts.astro'
import { getPublicProjects, type ProjectEntry } from '../../content/queries'

export async function getStaticPaths() {
  const projects = await getPublicProjects()
  return projects.map((project: ProjectEntry) => ({
    params: { slug: project.data.slug },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)
---

<ProjectLayout
  title={project.data.title}
  description={project.data.summary}
  updatedAt={project.data.updatedAt}
>
  <ProjectFacts slot="facts" project={project} />

  <Content />
</ProjectLayout>
