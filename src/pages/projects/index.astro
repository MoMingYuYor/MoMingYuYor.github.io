---
/**
 * 作品索引（S2-T5；规格第 2、3、11.2 节）。
 *
 * 形态由内容决定：0 条真实空状态、1 条用完整可用区域、多条才出现索引布局。
 * 数据只来自 `getPublicProjects()`——草稿与未到发布日期的条目既不出现在列表里，
 * 也不会生成详情页。
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProjectEntrySummary from '../../components/project/ProjectEntrySummary.astro'
import { getPublicProjects } from '../../content/queries'
import { identity } from '../../lib/site'
import { selectPresentation } from '../../lib/presentation'

const projects = await getPublicProjects()
const mode = selectPresentation(projects.length)

const pageTitle = `作品 · ${identity.brand}`
const pageDescription = `${identity.brand} 的软件项目：问题与约束、本人贡献、关键决策与结果证据。`
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="container">
    <header class="index-intro">
      <h1 class="index-intro__title">作品</h1>
      <p class="index-intro__lead">{pageDescription}</p>
    </header>

    <section
      class:list={['section', 'section--first', mode === 'single' ? 'projects-single' : null]}
      aria-label="项目列表"
      data-projects-index
      data-presentation={mode}
    >
      {mode === 'empty' ? <p class="index-empty">暂无公开作品。</p> : null}
      {
        mode !== 'empty' ? (
          <div class="projects-list">
            {projects.map((project) => (
              <ProjectEntrySummary project={project} />
            ))}
          </div>
        ) : null
      }
    </section>
  </div>
</BaseLayout>

<style>
  .index-intro {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .index-intro__lead {
    max-width: 36em;
    margin-block-start: var(--space-sm);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg);
  }

  .index-empty {
    max-width: 36em;
    color: var(--color-text-secondary);
  }

  .projects-list {
    display: grid;
    gap: var(--space-2xl);
  }

  /* 单条时用完整可用区域，不做两栏留白（规格 11.2） */
  .projects-single .projects-list {
    max-inline-size: 46em;
  }
</style>
